{
  "name": "cos750-final-project",
  "version": "0.1.0",
  "private": true,
  "description": "COS212 BST app: a pre-lecture tutor for binary search trees.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "answers": "vite build --ssr scripts/answers.ts --outDir .answers --emptyOutDir --logLevel error && node .answers/answers.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
